---
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import { linkWhatsApp } from '../../data/sitio';

type Casa = {
  slug: string; nombre: string; huespedes: number; dormitorios: number; camas: number; banos: number;
  comodidades: string[]; diferencia: string; foto: { carpeta: 'casa-1' | 'casa-2'; archivo?: string; pide: string };
};
const casas = Object.values(import.meta.glob<{ frontmatter: Casa }>('../../content/casas/es/*.md', { eager: true }))
  .map((m) => m.frontmatter)
  .sort((a, b) => a.slug.localeCompare(b.slug));

const consulta = 'Hola Analía, quería consultar disponibilidad en Palo Rosa House.';

// Luz de cada momento. Paleta provisoria: se ajusta con las fotos reales.
const momentos = [
  { hora: '07:30', frase: 'Mate en la galería, la selva despertando.',
    nota: 'Wifi en las dos casas y espacio de trabajo en la Casa 1, por si hace falta.',
    foto: { carpeta: 'casa-1', archivo: 'galeria-sillones.jpg', pide: 'Galería o exterior con verde, luz de mañana temprano' },
    bg: '#e8eff2', ink: '#16292d' },
  { hora: '09:00', frase: 'Cataratas. El agua que ruge.',
    nota: 'Estacionamiento en la propiedad, para salir temprano.',
    foto: { carpeta: 'iguazu', archivo: 'cataratas-saltos.jpg', pide: 'Cataratas de cerca, con caudal y bruma, luz de mañana' },
    bg: '#dbe6ea', ink: '#122529' },
  { hora: '15:00', frase: 'Vuelta a casa. El agua quieta. La pileta es solo de ustedes.',
    nota: 'Pileta en las dos casas.',
    foto: { carpeta: 'casa-2', archivo: 'galeria-mesa-pileta.jpg', pide: 'Pileta quieta a la tarde, sin gente o con gente de espaldas' },
    bg: '#efdcd3', ink: '#3a2219' },
  { hora: '20:00', frase: 'Parrilla y mesa larga.',
    nota: 'Cocina en las dos casas, para cinco o seis a la mesa.',
    foto: { carpeta: 'casa-1', archivo: 'galeria-mesa-noche.jpg', pide: 'Parrilla o mesa puesta, al atardecer o con luz artificial' },
    bg: '#3b2621', ink: '#f2e2da' },
  { hora: '23:00', frase: 'Silencio. La casa entera para ustedes.',
    nota: 'Dos dormitorios y cuatro camas por casa: hasta cinco huéspedes en la Casa 1 y seis en la Casa 2.',
    foto: { carpeta: 'casa-2', archivo: 'pileta-noche-casa.jpg', pide: 'Casa de noche con luces encendidas, o dormitorio en penumbra' },
    bg: '#0e1517', ink: '#c9d4d6' },
] as const;
---
<Base
  lang="es"
  ruta="/"
  titulo="Palo Rosa House · Casas en Puerto Iguazú"
  descripcion="Dos casas enteras con pileta en Puerto Iguazú, Misiones. A la mañana, las Cataratas; a la tarde, la pileta. Reserva directa con Analía."
  textoWhatsApp={consulta}
  etiquetaWhatsApp="Consultar por WhatsApp"
>
  <main>
    <section class="hero" data-luz data-bg={momentos[0].bg} data-ink={momentos[0].ink}>
      <div class="hero__agua hero__agua--ruge">
        <Foto carpeta="iguazu" archivo="cataratas-vertical.jpg" pide="Cataratas: el agua cayendo, encuadre vertical o centrado" alt="Las Cataratas del Iguazú" sizes="(min-width: 768px) 50vw, 100vw" prioridad />
      </div>
      <div class="hero__agua hero__agua--quieta">
        <Foto carpeta="casa-1" archivo="galeria-jardin-pileta.jpg" pide="Pileta de la casa, superficie quieta" alt="La pileta de la casa, quieta" sizes="(min-width: 768px) 50vw, 100vw" prioridad />
      </div>
      <div class="hero__texto">
        <h1>Palo Rosa House</h1>
        <p>A la mañana, la que ruge. A la tarde, la quieta.</p>
        <a class="wa" href={linkWhatsApp(consulta)} data-wa-hero>Consultar por WhatsApp</a>
      </div>
    </section>

    <section class="dia" aria-labelledby="dia-titulo">
      <h2 id="dia-titulo" class="dia__titulo">Un día en Palo Rosa House</h2>
      {momentos.map((m, i) => (
        <article class:list={['momento', { 'momento--espejo': i % 2 === 1 }]} data-luz data-bg={m.bg} data-ink={m.ink}>
          <div class="momento__foto">
            <Foto carpeta={m.foto.carpeta} archivo={m.foto.archivo} pide={m.foto.pide} sizes="(min-width: 768px) 60vw, 100vw" />
          </div>
          <div class="momento__texto">
            <p class="momento__hora"><time datetime={m.hora}>{m.hora}</time></p>
            <p class="momento__frase">{m.frase}</p>
            <p class="momento__nota">{m.nota}</p>
          </div>
        </article>
      ))}
    </section>

    <div class="cierre-noche" data-luz data-bg="#0e1517" data-ink="#c9d4d6">
      <section class="casas" aria-labelledby="casas-titulo">
        <h2 id="casas-titulo">Las dos casas</h2>
        <p class="casas__intro">Las dos se alquilan enteras, con pileta y estacionamiento adentro. Cambian en esto:</p>
        <div class="casas__lista">
          {casas.map((c) => (
            <article class="casa">
              <a class="casa__foto" href={`/es/casas/${c.slug}/`} tabindex="-1" aria-hidden="true">
                <Foto carpeta={c.foto.carpeta} archivo={c.foto.archivo} pide={c.foto.pide} sizes="(min-width: 768px) 50vw, 100vw" />
              </a>
              <h3><a href={`/es/casas/${c.slug}/`}>{c.nombre}</a></h3>
              <p class="casa__diferencia">{c.diferencia}</p>
              <p class="casa__datos">
                {c.huespedes} huéspedes, {c.dormitorios} dormitorios, {c.camas} camas, {c.banos} {c.banos === 1 ? 'baño' : 'baños'}.
                {' '}{c.comodidades.join(', ')}.
              </p>
              <a class="casa__link" href={`/es/casas/${c.slug}/`}>Ver la {c.nombre}</a>
            </article>
          ))}
        </div>
      </section>

      <section class="directo" aria-labelledby="directo-titulo">
        <h2 id="directo-titulo">Reservá directo</h2>
        <div class="directo__texto">
          <p>Son las mismas casas que ves en las plataformas. Reservando acá no pagás su comisión.</p>
          <p>Del otro lado está Analía, que hace ocho años recibe huéspedes. Le escribís, te contesta ella, y con ella arreglás llegada, dudas y todo lo demás.</p>
        </div>
      </section>

      <section class="consulta" aria-labelledby="consulta-titulo">
        <h2 id="consulta-titulo">¿Qué fechas tienen en mente?</h2>
        <p>Contale a Analía cuándo vienen y cuántos son.</p>
        <a class="wa" href={linkWhatsApp(consulta)}>Consultar por WhatsApp</a>
      </section>

      <footer class="pie">
        <p>Palo Rosa House · Puerto Iguazú, Misiones, Argentina</p>
        <p>Sitio por Talamo Agency</p>
      </footer>
    </div>
  </main>

  <script>
    // Único efecto del sitio: el fondo y el tono siguen la luz del día según el scroll.
    const tramos = [...document.querySelectorAll<HTMLElement>('[data-luz]')];
    const reducir = matchMedia('(prefers-reduced-motion: reduce)');
    const raiz = document.documentElement.style;
    const rgb = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
    const colores = tramos.map((t) => ({ bg: rgb(t.dataset.bg!), ink: rgb(t.dataset.ink!) }));
    const mezcla = (a: number[], b: number[], f: number) => `rgb(${a.map((v, i) => Math.round(v + (b[i] - v) * f)).join(',')})`;

    let pendiente = false;
    function pintar() {
      pendiente = false;
      const medio = innerHeight / 2;
      const centros = tramos.map((t) => {
        const r = t.getBoundingClientRect();
        // El tramo final es largo: su luz rige desde que asoma su primera pantalla.
        return t.classList.contains('cierre-noche') ? r.top + innerHeight / 2 - medio : r.top + r.height / 2 - medio;
      });
      let i = centros.findIndex((c) => c > 0);
      if (i === -1) i = centros.length;
      let a: number, b: number, f: number;
      if (i === 0) [a, b, f] = [0, 0, 0];
      else if (i === centros.length) [a, b, f] = [i - 1, i - 1, 0];
      else {
        a = i - 1; b = i;
        f = -centros[a] / (centros[b] - centros[a]);
        f = reducir.matches ? Math.round(f) : f * f * (3 - 2 * f);
      }
      raiz.setProperty('--bg', mezcla(colores[a].bg, colores[b].bg, f));
      raiz.setProperty('--ink', mezcla(colores[a].ink, colores[b].ink, f));
    }
    const pedir = () => { if (!pendiente) { pendiente = true; requestAnimationFrame(pintar); } };
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir);
    pintar();

    // El botón fijo de WhatsApp aparece cuando el del hero deja de verse.
    const fija = document.querySelector<HTMLElement>('[data-wa-fija]');
    const delHero = document.querySelector('[data-wa-hero]');
    if (fija && delHero) {
      new IntersectionObserver(([e]) => { fija.hidden = e.isIntersecting; }).observe(delHero);
    }
  </script>
</Base>
